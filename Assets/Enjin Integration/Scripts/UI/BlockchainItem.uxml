<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Enjin%20Integration/Scripts/UI/BlockchainItem.uss?fileID=7433441132597879392&amp;guid=92805606d7e8347db8d0c350b6fb952c&amp;type=3#BlockchainItem" />
    <engine:VisualElement name="Item" style="flex-grow: 1; white-space: normal; flex-direction: row; width: auto;">
        <engine:Label text="Name" name="ItemName" style="width: 130px; color: rgb(255, 255, 255); -unity-text-align: middle-left; align-self: center;" />
        <engine:Label text="0" name="OwnedAmount" tooltip="Amount owned" style="width: 70px; color: rgb(255, 255, 255); -unity-text-align: middle-left; align-self: center;" />
        <engine:IntegerField value="1" name="ItemDetails" style="width: 90px; background-size: 100% 100%;" />
        <engine:Button text="Melt" name="MeltButton" />
        <engine:Button text="Send" name="TransferButton" />
    </engine:VisualElement>
</engine:UXML>
